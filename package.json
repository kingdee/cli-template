{
    "name": "@kdcloudjs/kwc-template",
    "version": "1.0.0",
    "description": "kwc template",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_ENV=production node scripts/build.js",
        "dev": "cross-env NODE_ENV=development rollup -c rollup.config.js --watch",
        "server": "node server.js",
        "debug": "cross-env NODE_ENV=production DEBUG_BUILD=true node scripts/build.js --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@kdcloudjs/kwc": "1.0.0",
        "@kdcloudjs/kwc-shared-utils": "0.x",
        "@kdcloudjs/shoelace": "^1.0.1"
    },
    "devDependencies": {
        "@kdcloudjs/eslint-config-kwc": "^1.0.2",
        "@kdcloudjs/eslint-plugin-kwc": "^1.0.2",
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^0.4.4",
        "cross-env": "^7.0.3",
        "eslint": "^9.35.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^28.14.0",
        "express": "^5.2.1",
        "jest": "^30.1.3",
        "lint-staged": "^15.5.2",
        "rimraf": "^5.0.10",
        "rollup": "^4.50.0",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-livereload": "^2.0.5",
        "rollup-plugin-serve": "^3.0.0"
    },
    "lint-staged": {
        "app/kwc/**/*.js": "eslint --max-warnings 0"
    },
    "overrides": {
        "rollup-plugin-terser": "npm:@rollup/plugin-terser"
    }
}