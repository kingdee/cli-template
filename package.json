    "express": "^5.2.1",
    "globals": "^17.0.0",
    "jsdom": "^23.0.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.2",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
