{
  "eslint.useFlatConfig": true,
  "files.associations": {
    "*.tsx": "typescriptreact",
    "*.ts": "typescript"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "eslint.enable": true,
  "javascript.validate.enable": false,
  "typescript.validate.enable": true
}